load("@rules_lean//lean:defs.bzl", "lean_binary", "lean_library", "lean_test")

package(default_visibility = ["//visibility:public"])

# The interpreter, one target per module: lexer, reader, compiler to core
# forms, environment, primitives, evaluator. `Scheme.lean` is the root module.
lean_library(
    name = "token",
    srcs = ["Scheme/Token.lean"],
)

lean_library(
    name = "sexp",
    srcs = ["Scheme/Sexp.lean"],
)

lean_library(
    name = "lexer",
    srcs = ["Scheme/Lexer.lean"],
    deps = [":token"],
)

lean_library(
    name = "parser",
    srcs = ["Scheme/Parser.lean"],
    deps = [
        ":sexp",
        ":token",
    ],
)

lean_library(
    name = "ast",
    srcs = ["Scheme/Ast.lean"],
    deps = [":sexp"],
)

lean_library(
    name = "env",
    srcs = ["Scheme/Env.lean"],
    deps = [":ast"],
)

lean_library(
    name = "prim",
    srcs = ["Scheme/Prim.lean"],
    deps = [":env"],
)

lean_library(
    name = "eval",
    srcs = ["Scheme/Eval.lean"],
    deps = [
        ":ast",
        ":env",
        ":prim",
    ],
)

lean_library(
    name = "interp",
    srcs = ["Scheme.lean"],
    deps = [
        ":ast",
        ":env",
        ":eval",
        ":lexer",
        ":parser",
        ":prim",
        ":sexp",
        ":token",
    ],
)

# 31 checks over the lexer, the reader, the evaluator, and the error paths.
lean_test(
    name = "scheme_test",
    size = "small",
    srcs = ["Scheme/Test/Eval.lean"],
    entry = "Scheme/Test/Eval.lean",
    deps = [
        ":ast",
        ":env",
        ":eval",
        ":lexer",
        ":parser",
    ],
)

# The REPL, linked natively. `--eval` and `--file` take expressions and programs;
# with no arguments it reads stdin.
lean_binary(
    name = "scheme",
    data = ["Fact.scm"],
    main = "Scheme.Repl",
    srcs = ["Scheme/Repl.lean"],
    deps = [":interp"],
)
