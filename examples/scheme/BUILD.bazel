load("@rules_lean//lean:defs.bzl", "lean_binary", "lean_library", "lean_test")

package(default_visibility = ["//visibility:public"])

# The interpreter as a single library: the ruleset scans the import graph to
# order the modules and compile them with full parallelism. See M0b in the README.
lean_library(
    name = "interp",
    srcs = [
        "Scheme.lean",
        "Scheme/Ast.lean",
        "Scheme/Env.lean",
        "Scheme/Eval.lean",
        "Scheme/Lexer.lean",
        "Scheme/Parser.lean",
        "Scheme/Prim.lean",
        "Scheme/Sexp.lean",
        "Scheme/Token.lean",
    ],
)

# 31 checks over the lexer, the reader, the evaluator, and the error paths.
lean_test(
    name = "scheme_test",
    size = "small",
    srcs = ["Scheme/Test/Eval.lean"],
    entry = "Scheme/Test/Eval.lean",
    deps = [":interp"],
)

# The REPL, linked natively. `--eval` and `--file` take expressions and programs;
# with no arguments it reads stdin.
lean_binary(
    name = "scheme",
    srcs = ["Scheme/Repl.lean"],
    data = ["Fact.scm"],
    main = "Scheme.Repl",
    deps = [":interp"],
)
