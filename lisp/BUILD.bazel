load("@rules_lean//lean:defs.bzl", "lean_library", "lean_test")

package(default_visibility = ["//visibility:public"])

# The machine as a single target: the ruleset scans the import graph to order
# the modules and compile them with full parallelism. See M0b in the README.
lean_library(
    name = "lisp",
    srcs = [
        "Lisp.lean",
        "Lisp/Compile.lean",
        "Lisp/Eval.lean",
        "Lisp/Expr.lean",
        "VM/Machine.lean",
        "VM/Word.lean",
    ],
)

# Runs the evaluator and the machine on the same expressions and compares.
lean_test(
    name = "lisp_test",
    size = "small",
    srcs = ["Lisp/Test/Eval.lean"],
    entry = "Lisp/Test/Eval.lean",
    deps = [":lisp"],
)
