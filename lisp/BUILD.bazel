load("@rules_lean//lean:defs.bzl", "lean_axiom_test", "lean_binary", "lean_library", "lean_test")

package(default_visibility = ["//visibility:public"])

# A rule-generated Lean source module.
genrule(
    name = "gen_prog",
    outs = ["Lisp/Generated.lean"],
    cmd = """printf '%s\\n' \\
      'import Lisp.Expr' \\
      '' \\
      'namespace Lisp.Generated' \\
      '' \\
      '/-- A program generated by a build rule. -/' \\
      'def sample : Lisp.Expr :=' \\
      '  .letE "x" (.lit 40) (.op .add (.var "x") (.lit 2))' \\
      '' \\
      'end Lisp.Generated' > $@""",
)

# The machine library as a single target: the ruleset scans the import graph to
# order the modules and compile them with full parallelism. See M0b in the README.
lean_library(
    name = "core",
    srcs = [
        "Lisp.lean",
        "Lisp/Compile.lean",
        "Lisp/Correctness.lean",
        "Lisp/Env.lean",
        "Lisp/Eval.lean",
        "Lisp/Expr.lean",
        "Lisp/Generated.lean",
        "Lisp/Parser.lean",
        "Lisp/Subst.lean",
        "Lisp/Tools/Gen.lean",
        "VM/Machine.lean",
        "VM/Word.lean",
    ],
    internal_imports = {
        "Lisp": [
            "Lisp.Compile",
            "Lisp.Correctness",
            "Lisp.Env",
            "Lisp.Eval",
            "Lisp.Expr",
            "Lisp.Generated",
            "Lisp.Parser",
            "Lisp.Subst",
            "Lisp.Tools.Gen",
            "VM.Machine",
            "VM.Word",
        ],
        "Lisp.Generated": ["Lisp.Expr"],
        "Lisp.Parser": ["Lisp.Expr"],
        "Lisp.Tools.Gen": ["Lisp.Expr"],
    },
    deps = ["@mathlib//:mathlib"],
    forbid_sorry = True,
)

lean_axiom_test(
    name = "correctness_axiom_test",
    allowed_axioms = [
        "propext",
        "Classical.choice",
        "Quot.sound",
    ],
    deps = [":core"],
    theorems = [
        "Lisp.run_lit",
        "Lisp.eval_lit",
        "Lisp.compile_correct_lit",
        "Lisp.compile_correct_ite",
        "Lisp.compile_correct_letE",
    ],
)

# Runs the evaluator and the machine on the same expressions and compares.
lean_test(
    name = "lisp_test",
    size = "small",
    srcs = ["Lisp/Test/Eval.lean"],
    entry = "Lisp/Test/Eval.lean",
    deps = [":core"],
)

# The command line tool: native executable. Reads prog.lisp from runfiles or args.
lean_binary(
    name = "lisp",
    srcs = ["Lisp/Main.lean"],
    data = ["prog.lisp"],
    internal_imports = {
        "Lisp.Main": ["Lisp.Compile", "Lisp.Expr", "Lisp.Parser", "VM.Machine"],
    },
    main = "Lisp.Main",
    deps = [":core"],
)
