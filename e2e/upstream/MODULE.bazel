module(name = "e2e_upstream", version = "0.0.0")

bazel_dep(name = "rules_lean", version = "0.0.0")

lean = use_extension("@rules_lean//lean:extensions.bzl", "lean")
lean.toolchain(toolchain_file = "//:lean-toolchain")
use_repo(lean, "lean_toolchains")

register_toolchains("@lean_toolchains//:all")

# The compiler test suite of the Lean repository at the tag of the toolchain.
# The flags come from the upstream drivers:
#   tests/elab/run_test.sh, tests/elab_fail/run_test.sh, tests/compile/run_test.sh
upstream = use_extension("//upstream:extensions.bzl", "upstream")
upstream.samples(
    tag = "v4.34.1",
    sha256 = "9bb0bed7bae752a281e9923163d50da4193e36480cf5f639658e2e1502294056",
    piles = {
        "compile": "tests/compile",
        "elab": "tests/elab",
    },
    flags = {
        "compile": ["-Dcompiler.postponeCompile=false"],
        "elab": [
            "-DprintMessageEndPos=true",
            "-Dlinter.all=false",
            "-DElab.inServer=true",
            "-Dcompiler.postponeCompile=false",
        ],
    },
    link_flags = [
        "-O3",
        "-DNDEBUG",
    ],
    native_piles = ["compile"],
    # The upstream driver runs each test with the pile directory as the working
    # directory, with the environment of its `.init.sh`, and with a writable
    # file system. The rules give an action a sandbox and a fixed working
    # directory, so these six files need the test-driver features of stage 2:
    #   Reformat, readDir, parsePrelude   read a path relative to the cwd
    #   importStructure                   runs `lean` as a subprocess
    #   async_systems_info                spawns a process, denied in the sandbox
    excludes = [
        "tests/elab/async_base_functions.lean",
        "tests/elab/async_select_channel.lean",
        "tests/elab/async_systems_info.lean",
        "tests/elab/importStructure.lean",
        "tests/elab/parsePrelude.lean",
        "tests/elab/readDir.lean",
        "tests/elab/Reformat.lean",
        "tests/elab/sync_mutex.lean",
    ],
    excluded_piles = {
        "doc/examples/compiler": "drives leanmake, not lean",
        "tests/bench": "measures speed, does not check a result",
        "tests/elab_fail": "negative tests: stage 3",
        "tests/ir": "dead harness: imports init.Lean.Ir.lirc, which no longer exists",
        "tests/lake": "tests Lake",
        "tests/lean": "aspirational and scratch files, not a suite",
        "tests/pkg": "tests Lake",
        "tests/server": "tests the language server",
    },
)
use_repo(upstream, "lean_samples")
